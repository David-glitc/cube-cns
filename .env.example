# Copy to .env on the VPS (not committed).
CNS_HOST=0.0.0.0
CNS_PORT=8765
CNS_PUBLIC_HOST=cube.atomiclabs.cc
CNS_ALLOWED_HOSTS=cube.atomiclabs.cc,localhost,127.0.0.1
CNS_ALLOWED_IPS=127.0.0.1,::1,10.0.0.0/8
CNS_BLOCK_PUBLIC=1

CUBE_ROOT=/path/to/cube
CNS_STORAGE_PATH=/path/to/cube/storage/signet/states

CNS_CUBE_SCRIPT=/path/to/cube/run-cube.sh
CNS_CUBE_NODE_ARGS="pruned signet node http://127.0.0.1:38332 cube cube true"
CNS_CUBE_BITCOIND_RPC=http://127.0.0.1:38332
CNS_CUBE_BITCOIND_USER=cube
CNS_CUBE_BITCOIND_PASS=cube
CNS_CUBE_BITCOIND_CONTAINER=cube-bitcoind-signet
CNS_CUBE_SEEDS_DIR=/path/to/cube/data/seeds

# SysMon Cube relay (TheBox → private node on :8765)
CNS_SYSMON_URL=http://127.0.0.1:8765
CNS_SYSMON_TOKEN=same-as-SYSMON_TOKEN
CNS_NODE_RELAY=1
CNS_NODE_RELAY_PUBLIC=1
